library(tidyverse)
options(scipen = 999)
# Simulated A/B test: 400 randomly selected users, randomly split into
# two groups of 200. The treatment group sees the new "Smart Mix" feature.
# Outcome: listening hours in the four weeks after the start of the test.
set.seed(31)
ab_test <- tibble(
group = factor(rep(c("Control", "Smart Mix"), each = 200), levels = c("Smart Mix", "Control")),
hours = c(rgamma(200, shape = 2, scale = 10), rgamma(200, shape = 2, scale = 11.5))
)
# The dashboard view: two group means as bars (point estimates only)
ab_test |>
group_by(group) |>
summarise(mean_hours = mean(hours)) |>
ggplot(aes(x = group, y = mean_hours)) +
geom_col(width = 0.55, fill = "#0f5da8") +
labs(x = NULL, y = "Mean listening hours (four weeks)") +
theme_minimal()
# Group means, medians, and spread: Smart Mix users listened about 3 hours more
ab_test |>
group_by(group) |>
summarise(n = n(), mean_hours = mean(hours), median_hours = median(hours), sd_hours = sd(hours))
ggplot(ab_test, aes(x = group, y = hours)) +
geom_jitter(width = 0.18, height = 0, alpha = 0.35) +
stat_summary(fun = mean, geom = "point", color = "#0f5da8", size = 5) +
coord_flip() +
labs(x = NULL, y = "Listening hours in the four weeks after the start of the test") +
theme_minimal()
# Real effect or noise? The t-test output is explained in Chapters 3 and 4
t.test(hours ~ group, data = ab_test)
# (1) A larger sample: 2,000 users per group, rescaled to the original means
ab_means <- ab_test |> group_by(group) |> summarise(m = mean(hours))
set.seed(32)
ab_large <- tibble(
group = factor(rep(c("Control", "Smart Mix"), each = 2000), levels = c("Smart Mix", "Control")),
hours = c(rgamma(2000, shape = 2, scale = 10), rgamma(2000, shape = 2, scale = 11.5))
) |>
group_by(group) |>
mutate(hours = hours * ab_means$m[match(group, ab_means$group)] / mean(hours)) |>
ungroup()
ab_large |> group_by(group) |> summarise(n = n(), mean_hours = mean(hours), sd_hours = sd(hours))
t.test(hours ~ group, data = ab_large)      # same difference, larger t, smaller p, narrower CI
# (2) More similar users: the original 400 users, pulled halfway toward their group mean
ab_similar <- ab_test |>
group_by(group) |>
mutate(hours = mean(hours) + 0.5 * (hours - mean(hours))) |>
ungroup()
ab_similar |> group_by(group) |> summarise(n = n(), mean_hours = mean(hours), sd_hours = sd(hours))
t.test(hours ~ group, data = ab_similar)    # same difference, same n, less spread -> less uncertainty
# A simulated population: monthly listening time (hours) of all
# 25,000 WU students. Because we simulate it, we know the true values.
set.seed(321)
population <- rnorm(25000, mean = 50, sd = 10)
mean(population)   # population mean (mu)
sd(population)     # population standard deviation (sigma)
ggplot(tibble(hours = population), aes(hours)) +
geom_histogram(bins = 60, fill = "#dbe7f3", color = "white") +
geom_vline(xintercept = mean(population), color = "#0a3d6e", linewidth = 1) +
labs(x = "Hours per month", y = "Number of students") +
theme_minimal()
# One random sample of 100 students ...
set.seed(6789)
sample_1 <- sample(population, size = 100)
mean(sample_1)
# ... and another one: a different mean (sampling variation)
sample_2 <- sample(population, size = 100)
mean(sample_2)
# The sampling distribution: the means of many samples
set.seed(12345)
sample_means <- replicate(20000, mean(sample(population, size = 100)))
mean(sample_means)   # close to the population mean
sd(sample_means)     # the standard error
ggplot(tibble(mean = sample_means), aes(mean)) +
geom_histogram(bins = 50, fill = "#0f5da8", color = "white") +
geom_vline(xintercept = mean(population), color = "#b03a2e", linetype = "dashed") +
labs(x = "Sample mean (hours per month)", y = "Number of samples") +
theme_minimal()
# Standard error from the formula: sigma / sqrt(n)
sd(population) / sqrt(100)
# The square-root law: 4x the sample size, half the standard error
tibble(n = c(25, 100, 400, 1600)) |>
mutate(se = sd(population) / sqrt(n))
# In practice we do not know sigma -> estimate it with the sample SD
sd(sample_1) / sqrt(length(sample_1))
# A right-skewed population (most students listen a moderate amount,
# a few listen a lot)
set.seed(321)
population_skewed <- rgamma(25000, shape = 2, scale = 10)
ggplot(tibble(hours = population_skewed), aes(hours)) +
geom_histogram(bins = 60, fill = "#dbe7f3", color = "white") +
labs(x = "Hours per month", y = "Number of students") +
theme_minimal()
# Sample means for different sample sizes: the larger n, the more
# normal (and the narrower) the distribution of the sample means
set.seed(12345)
clt <- map_dfr(c(1, 5, 30, 100), function(size) {
tibble(n    = paste("n =", size),
mean = replicate(10000, mean(sample(population_skewed, size = size))))
}) |>
mutate(n = fct_inorder(n))
ggplot(clt, aes(mean)) +
geom_histogram(bins = 50, fill = "#0f5da8", color = "white") +
facet_wrap(~ n, nrow = 1, scales = "free") +
labs(x = "Sample mean (hours per month)", y = "Number of samples") +
theme_minimal()
# Critical values
qnorm(0.975)           # normal distribution: 1.96
qt(0.975, df = 99)     # t-distribution with n = 100: 1.98
qt(0.975, df = 9)      # t-distribution with n = 10: 2.26
# How often does a 95% confidence interval contain the true mean?
# (100 samples, 100 intervals)
set.seed(12345)
intervals <- map_dfr(1:100, function(i) {
x  <- sample(population, size = 100)
se <- sd(x) / sqrt(100)
tibble(sample = i,
lower  = mean(x) - qt(0.975, 99) * se,
upper  = mean(x) + qt(0.975, 99) * se)
}) |>
mutate(contains_mu = lower <= mean(population) & upper >= mean(population))
count(intervals, contains_mu)   # about 95 of 100
# A random sample of 100 students from the (unknown) skewed population
set.seed(6789)
listening <- tibble(hours = sample(population_skewed, size = 100))
# --- Confidence interval for a mean, step by step -----------------------
n    <- nrow(listening)
xbar <- mean(listening$hours)
se   <- sd(listening$hours) / sqrt(n)     # standard error of the mean
crit <- qt(0.975, df = n - 1)             # critical value (95%)
c(mean = xbar, se = se, lower = xbar - crit * se, upper = xbar + crit * se)
# --- The same in one line --------------------------------------------------
t.test(listening$hours)$conf.int
# --- Back to the A/B test: confidence intervals per group ----------------
ab_test |>
group_by(group) |>
summarise(
n     = n(),
mean  = mean(hours),
se    = sd(hours) / sqrt(n),
lower = mean - qt(0.975, n - 1) * se,
upper = mean + qt(0.975, n - 1) * se
)
# The dashboard view again — now with 95% confidence intervals
ab_test |>
group_by(group) |>
summarise(n = n(), mean = mean(hours), se = sd(hours) / sqrt(n),
lower = mean - qt(0.975, n - 1) * se, upper = mean + qt(0.975, n - 1) * se) |>
ggplot(aes(x = group, y = mean)) +
geom_col(width = 0.55, fill = "#0f5da8") +
geom_errorbar(aes(ymin = lower, ymax = upper), width = 0.15) +
labs(x = NULL, y = "Mean listening hours (95% CI)") +
theme_minimal()
# The confidence interval for the DIFFERENCE between the groups
# (computed by t.test(); explained in Chapter 4)
t.test(hours ~ group, data = ab_test)$conf.int
# --- A confidence interval for a share: the poll from 3.7 -------------------
n_poll <- 1000
p_hat  <- c(Harris = 0.49, Trump = 0.44)
se_p   <- sqrt(p_hat * (1 - p_hat) / n_poll)
cbind(share = p_hat, lower = p_hat - 1.96 * se_p, upper = p_hat + 1.96 * se_p)
# The same with prop.test(): number of "successes" and sample size
prop.test(x = 490, n = 1000)$conf.int
# --- The margin of error of a poll -----------------------------------------
# 1,000 respondents, share of about 50%
qnorm(0.975) * sqrt(0.5 * 0.5 / 1000)     # 0.031 = 3.1 percentage points
library(tidyverse)
library(psych)        # cohen.d()
options(scipen = 5, digits = 4)
base_url <- "https://raw.githubusercontent.com/wu-rds/MA2026/main/data/"
# The Smart Mix A/B test: 400 users, randomly split; listening hours in four weeks
ab_test <- read_csv(paste0(base_url, "ab_test.csv")) |>
mutate(group = factor(group, levels = c("Smart Mix", "Control")))
# Three versions of Smart Mix: 150 users each
mix_test <- read_csv(paste0(base_url, "mix_test.csv")) |>
mutate(version = factor(version, levels = c("No mix", "Weekly mix", "Daily mix")))
# The search-design test: 60 users, each tried both designs (seconds per search)
search_test <- read_csv(paste0(base_url, "search_test.csv"))
# --- Step 1: look at the data ---------------------------------------------
# Boxplot with the individual users on top: how many, how spread out, outliers?
ggplot(ab_test, aes(x = group, y = hours)) +
geom_boxplot(fill = "#dbe7f3", outlier.shape = NA) +
geom_jitter(width = 0.15, height = 0, alpha = 0.3) +
stat_summary(fun = mean, geom = "point", color = "#b03a2e", size = 3) +    # red dot = mean
labs(x = NULL, y = "Listening hours (four weeks)") +
theme_minimal()
# --- Step 2: the group summaries you will report --------------------------
ab_summary <- ab_test |>
group_by(group) |>
summarise(n = n(), mean = mean(hours), sd = sd(hours), se = sd / sqrt(n)) |>
mutate(lower = mean - qt(0.975, n - 1) * se,       # 95% confidence interval
upper = mean + qt(0.975, n - 1) * se)
ab_summary
# --- Step 3: the chart that goes with the test ----------------------------
# Group means with their 95% confidence intervals
ggplot(ab_summary, aes(x = group, y = mean)) +
geom_col(width = 0.55, fill = "#0f5da8") +
geom_errorbar(aes(ymin = lower, ymax = upper), width = 0.15) +
labs(x = NULL, y = "Mean listening hours (95% CI)") +
theme_minimal()
# (The same in one pipe — handy for a quick look, but keep the summary
#  as a separate object when you need it for a table or a report.)
ab_test |>
group_by(group) |>
summarise(n = n(), mean = mean(hours), se = sd(hours) / sqrt(n)) |>
mutate(lower = mean - qt(0.975, n - 1) * se, upper = mean + qt(0.975, n - 1) * se) |>
ggplot(aes(x = group, y = mean)) +
geom_col(width = 0.55, fill = "#0f5da8") +
geom_errorbar(aes(ymin = lower, ymax = upper), width = 0.15) +
theme_minimal()
# --- Step 4: the test -------------------------------------------------------
# Welch t-test (R's default: equal variances not assumed)
t.test(hours ~ group, data = ab_test)
# Pieces of the output you may want separately
t_result <- t.test(hours ~ group, data = ab_test)
t_result$estimate    # the two group means
t_result$conf.int    # 95% confidence interval of the difference
t_result$p.value
# One-sided test (only if decided before seeing the data)
t.test(hours ~ group, data = ab_test, alternative = "greater")
# The search-design test: one row per user, one column per design
head(search_test)
# --- The data in "long" format: one row per user AND design -----------------
search_long <- search_test |>
pivot_longer(c(old_design, new_design), names_to = "design", values_to = "seconds") |>
mutate(design = factor(design, levels = c("old_design", "new_design")))
head(search_long)
# --- The chart that goes with the test: one line per user, old -> new ---------
ggplot(search_long, aes(x = design, y = seconds, group = user_id)) +
geom_line(alpha = 0.4, color = "grey50") +
geom_point(alpha = 0.6) +
stat_summary(aes(group = 1), fun = mean, geom = "line", color = "#b03a2e", linewidth = 1.5) +
labs(x = NULL, y = "Seconds to find a song") +
theme_minimal()
# --- The usual report chart: the two condition means with 95% CIs --------------
# NOTE: these intervals reflect the differences BETWEEN users (the vertical
# spread above) and overlap a lot — they are not the uncertainty the paired
# test uses. Always add the paired test result to the caption.
search_summary <- search_long |>
group_by(design) |>
summarise(n = n(), mean = mean(seconds), se = sd(seconds) / sqrt(n)) |>
mutate(lower = mean - qt(0.975, n - 1) * se, upper = mean + qt(0.975, n - 1) * se)
search_summary
ggplot(search_summary, aes(x = design, y = mean)) +
geom_col(width = 0.55, fill = "#0f5da8") +
geom_errorbar(aes(ymin = lower, ymax = upper), width = 0.15) +
labs(x = NULL, y = "Mean seconds to find a song (95% CI)") +
theme_minimal()
# --- The paired t-test: the mean of the within-user differences vs. zero -------
paired_result <- t.test(search_test$new_design, search_test$old_design, paired = TRUE)
paired_result
# The chart that matches the paired test: the mean difference with its 95% CI
difference_summary <- tibble(what = "New - old design",
estimate = paired_result$estimate,
lower = paired_result$conf.int[1], upper = paired_result$conf.int[2])
ggplot(difference_summary, aes(x = what, y = estimate)) +
geom_col(width = 0.4, fill = "#0f5da8") +
geom_errorbar(aes(ymin = lower, ymax = upper), width = 0.12) +
geom_hline(yintercept = 0, linetype = "dashed") +
labs(x = NULL, y = "Mean within-user difference in seconds (95% CI)") +
theme_minimal()
# The same data analyzed as if they were two independent groups (ignores the pairing):
# same difference, but a much larger p-value — comparing different people adds uncertainty
t.test(search_test$new_design, search_test$old_design)
# A paired t-test is nothing but a one-sample t-test of the within-user differences
# (compare the output with paired_result above: identical)
t.test(search_test$new_design - search_test$old_design)
# (1) BETWEEN-SUBJECTS: 300 new customers were randomly split; 150 received a
#     free-delivery voucher for their first four weeks, 150 did not.
#     Outcome: total order value (euros) in these four weeks.
delivery_voucher <- read_csv(paste0(base_url, "delivery_voucher.csv")) |>
mutate(group = factor(group, levels = c("Voucher", "No voucher")))
head(delivery_voucher)
# (2) WITHIN-SUBJECTS: 40 couriers delivered with the old routing app AND with
#     the new one (same type of shift, random order).
#     Outcome: average minutes per delivery with each app.
delivery_routes <- read_csv(paste0(base_url, "delivery_routes.csv"))
head(delivery_routes)
# Relative effect in % of the control group
group_means <- ab_test |> group_by(group) |> summarise(mean = mean(hours))
100 * diff(rev(group_means$mean)) / group_means$mean[group_means$group == "Control"]
# Cohen's d with the psych package (the sign reflects the order of the groups)
cohen.d(ab_test$hours, ab_test$group)$cohen.d
# Premium trial offer: 131 of 2,000 vs. 104 of 2,000 users upgraded
upgrade_rates <- tibble(group = factor(c("Trial offer", "Standard page"), levels = c("Trial offer", "Standard page")),
upgrades = c(131, 104), n = c(2000, 2000)) |>
mutate(rate = upgrades / n, se = sqrt(rate * (1 - rate) / n),
lower = rate - 1.96 * se, upper = rate + 1.96 * se)
upgrade_rates
library(tidyverse)
library(sandwich)     # robust standard errors (section 5.9)
library(lmtest)       # coeftest()
options(scipen = 5, digits = 4)
base_url <- "https://raw.githubusercontent.com/wu-rds/MA2026/main/data/"
# 5.1–5.6, 5.8  Smart Mix as an opt-in feature: 2,000 users (simulated; true effect +3 hours)
smartmix_obs <- read_csv(paste0(base_url, "smartmix_obs.csv")) |>
mutate(device = factor(device, levels = c("iOS", "Android", "Desktop")))
# Coding blocks 1 and 3  Podcast promotion: 400 episodes
podcast_promo <- read_csv(paste0(base_url, "podcast_promo.csv"))
# Coding block 2  Loyalty program of an online shop: 1,500 customers (opt-in)
loyalty_program <- read_csv(paste0(base_url, "loyalty_program.csv")) |>
mutate(device = factor(device, levels = c("Desktop", "Mobile")))
# 5.7, 5.9  Promotion campaigns for new releases: 500 campaigns (simulated)
campaigns <- read_csv(paste0(base_url, "campaigns.csv")) |>
mutate(genre = factor(genre, levels = c("Pop", "HipHop/Rap", "Rock", "Electro/Dance")))
# Coding block 4  Win-back offers: 1,200 users who uninstalled the app
app_reinstall <- read_csv(paste0(base_url, "app_reinstall.csv"))
# 5.10  Playlist listings: 290 songs x 21 weeks (real data, WU-RDS research project)
playlist <- read_csv(paste0(base_url, "playlist_did.csv")) |>
mutate(week = as.Date(week))
smartmix_obs |>
group_by(smart_mix) |>
summarise(n = n(), hours = mean(hours), prior_hours = mean(prior_hours))
# The correlation coefficient
cor(smartmix_obs$prior_hours, smartmix_obs$hours)
# Scatter plot with the regression line
ggplot(smartmix_obs, aes(prior_hours, hours)) +
geom_point(alpha = 0.25) +
geom_smooth(method = "lm", se = FALSE) +
labs(x = "Listening hours before the launch", y = "Listening hours after the launch") +
theme_minimal()
# The regression line (OLS): intercept and slope
model_line <- lm(hours ~ prior_hours, data = smartmix_obs)
coef(model_line)
model_naive <- lm(hours ~ smart_mix, data = smartmix_obs)
summary(model_naive)                       # the full output
confint(model_naive)                       # confidence intervals of the coefficients
round(coef(summary(model_naive)), 3)       # the coefficient table, rounded (for reports)
model_naive <- lm(hours ~ smart_mix, data = smartmix_obs)
summary(model_naive)                       # the full output
confint(model_naive)                       # confidence intervals of the coefficients
round(coef(summary(model_naive)), 3)       # the coefficient table, rounded (for reports)
summary(model_naive)$r.squared             # R-squared
# With one 0/1 predictor, the regression is the comparison of two means
t.test(hours ~ smart_mix, data = smartmix_obs, var.equal = TRUE)
head(podcast_promo)                        # loaded at the top
# Holding prior listening constant
model_prior <- lm(hours ~ smart_mix + prior_hours, data = smartmix_obs)
summary(model_prior)
# More variables, same logic
model_full <- lm(hours ~ smart_mix + prior_hours + tenure + premium + device, data = smartmix_obs)
summary(model_full)
confint(model_full)["smart_mix", ]
# R creates one dummy per category, relative to the reference (iOS)
coef(model_full)[c("premium", "deviceAndroid", "deviceDesktop")]
# Does device matter at all? Compare the model with and without it
model_nodevice <- lm(hours ~ smart_mix + prior_hours + tenure + premium, data = smartmix_obs)
anova(model_nodevice, model_full)
# Changing the reference category
smartmix_obs |>
mutate(device = relevel(device, ref = "Android")) |>
lm(hours ~ smart_mix + prior_hours + tenure + premium + device, data = _) |>
coef()
